# Copy to .env on the server (cp .env.example .env) and fill in. Never commit .env.

# Web address of the platform (point its DNS A record at the server first), and an email for the certificate.
DOMAIN=alfa.example.ht
ACME_EMAIL=ops@example.ht

# Image to run: :latest follows main; pin a commit (e.g. :sha-1a2b3c4) to roll back.
ALFA_IMAGE=ghcr.io/judejbpb/prepaid-fuel:latest

# First start only (empty database): the distributor admin account. Password 12+ characters.
# Change the password after the first sign-in, then you may remove these two lines.
ADMIN_LOGIN=admin@example.ht
ADMIN_PASSWORD=
ADMIN_NAME=Distributor admin

# Local snapshots in the data volume (/data/backups): every 6 hours, keep the last 28 (7 days).
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28

# Off-site copy (Litestream). Example for Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Optional: switches on AI statement reading, match suggestions, dispute help and the reports assistant.
ANTHROPIC_API_KEY=
