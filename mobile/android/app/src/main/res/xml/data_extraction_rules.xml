<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the WebView storage holds the terminal key, the wallet's signing key,
     its approval counter and queued offline sales, which must stay bound to this one device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
